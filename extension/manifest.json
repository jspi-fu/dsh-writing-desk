{
  "manifest_version": 3,
  "name": "图文创作台 · 网页收发",
  "short_name": "网页收发",
  "version": "0.1.0",
  "description": "图文创作台的浏览器侧窗口:一键把网页收进灵感墙,把成稿投递到公众号、知乎、掘金的草稿箱。",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs", "declarativeNetRequest"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": [
    "https://mp.weixin.qq.com/*",
    "https://www.zhihu.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://api.zhihu.com/*",
    "https://api.juejin.cn/*",
    "https://imagex.bytedanceapi.com/*",
    "https://zhihu-pics-upload.zhimg.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "收进图文创作台",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "options_page": "options/options.html"
}
