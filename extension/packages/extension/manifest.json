{
  "manifest_version": 3,
  "name": "DSwritesync",
  "short_name": "DSwritesync",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "version": "2.0.10",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "key": "",
  "action": {
    "default_icon": "assets/icon-48.png",
    "default_title": "__MSG_actionTitle__"
  },
  "side_panel": {
    "default_path": "src/popup/index.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "cookies",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "tabs",
    "downloads",
    "sidePanel",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mp.weixin.qq.com/s/*", "https://mp.weixin.qq.com/s?*"],
      "js": ["src/content/weixin.ts"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://mp.weixin.qq.com/cgi-bin/appmsg*"],
      "js": ["src/content/weixin-editor.ts"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://mp.toutiao.com/*"],
      "js": ["src/content/toutiao.ts"],
      "run_at": "document_end"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/extractor.ts"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "src/sync-dialog/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}